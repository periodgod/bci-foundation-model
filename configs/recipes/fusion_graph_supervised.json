{
  "model": {
    "architecture": "fusion",
    "sample_rate": 160,
    "patch_samples": 80,
    "dim": 64,
    "depth": 2,
    "heads": 4,
    "mlp_ratio": 3,
    "dropout": 0.1,
    "task": "classification",
    "outputs": 2,
    "graph": true,
    "graph_bins": 8
  },
  "labels": ["left_hand_imagery", "right_hand_imagery"],
  "training": {
    "objective": "supervised",
    "tuning": "full",
    "epochs": 40,
    "batch_size": 8,
    "lr": 0.001,
    "weight_decay": 0.01,
    "seed": 17,
    "device": "cpu",
    "threads": 4,
    "clip_grad": 1.0,
    "max_seconds": 7200,
    "selection_metric": "balanced_accuracy",
    "direction": "max",
    "channel_dropout": 0.3
  }
}
